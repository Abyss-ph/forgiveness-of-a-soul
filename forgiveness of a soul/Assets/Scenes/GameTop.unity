  m_Script: {fileID: 11500000, guid: f823c0390f55a1d4098c8e0da9ac45e2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcInteracao
  falas:
  - "Sapo-Mago: Isanel, filho do Sol! Tenho observado sua jornada contra as aberra\xE7\xF5es
    que dominam este planeta..."
  - 'Isanel: Como sabe meu nome...?'
  - "Sapo-Mago: Eu sei mais do que imagina, entre o passado e o futuro... E vejo
    uma esperan\xE7a em voc\xEA. "
  - "Isanel: Esperan\xE7a?"
  - "Sapo-Mago: H\xE1 seis ou sete s\xE9culos, um soberano maligno, Lenasi, o Rei
    de todas essas criaturas, dominou Mipaw, um planeta onde seres m\xE1gicos, como
    eu, viviam livremente. "
  - "Sapo-Mago: Naquele tempo, profetizei que algum dia um ser t\xE3o forte quanto
    Lenasi viria nos salvar. Esse \xE9 voc\xEA, Isanel."
  - "Sapo-Mago: Ao amanhecer, enfrente Lenasi, e salve Mipaw da ru\xEDna!"
  interactionUI: {fileID: 2038990230}
  dialogueManager: {fileID: 1804617729}
  entregaMissao: 1
  missao:
    titulo: Derrote Lenasi
    objetivos:
    - idAlvo: Nazyeth
      descricao: Mate Lenasi
      quantidadeNecessaria: 1
  marcaAoAceitar: missaoSapo
  falasEmAndamento:
  - "Termine a miss\xE3o primeiro.\n"
  falasConcluida:
  - "Eu sabia que voc\xEA iria conseguir."
